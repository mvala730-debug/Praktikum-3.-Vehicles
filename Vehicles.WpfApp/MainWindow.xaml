<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles" Height="620" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vehicles"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Sõiduki tüüp:" VerticalAlignment="Center"/>
            <ComboBox x:Name="TypeComboBox" Grid.Column="1" Height="27"/>
            <TextBlock Grid.Column="2" Text="Nimi:" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="NameTextBox" Grid.Column="3" Height="27"/>
            <TextBlock Grid.Column="4" Text="Läbisõit:" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBox x:Name="MileageTextBox" Grid.Column="5" Height="27" Text="0"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Kütus (l):" Width="110" VerticalAlignment="Center"/>
            <TextBox x:Name="FuelTextBox" Width="150" Height="27" Text="20"/>
            <Button Content="Lisa sõiduk" Width="110" Height="29" Margin="12,0,0,0"
                    Click="AddVehicleButton_Click"/>
            <Button Content="Move(10)" Width="100" Height="29" Margin="10,0,0,0"
                    Click="MoveButton_Click"/>
            <Button Content="Kustuta valitud" Width="120" Height="29" Margin="10,0,0,0"
                    Click="DeleteButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="VehiclesDataGrid" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tüüp" Binding="{Binding TypeName}" Width="150"/>
                <DataGridTextColumn Header="Nimi" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Läbisõit (km)" Binding="{Binding Mileage, StringFormat=N1}" Width="140"/>
                <DataGridTextColumn Header="Kütus (l)" Binding="{Binding FuelLevel, StringFormat=N2}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="4"
                   Foreground="DarkRed" Margin="0,8" TextWrapping="Wrap"/>

        <GroupBox Grid.Row="5" Header="Logi">
            <ListBox x:Name="LogListBox"/>
        </GroupBox>
    </Grid>
</Window>
